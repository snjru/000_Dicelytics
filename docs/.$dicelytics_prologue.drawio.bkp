        </mxCell>
        <mxCell id="deu0NN2QkaewtrAMbBJK-7" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;&amp;nbsp;Web Dicelytics (DicelyticsのJavaScript版ブラウザで動くプログラム) Github URL:&lt;br&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&amp;nbsp;https://github.com/snjru/001_Web_Dicelytics/blob/main/index.html&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&amp;nbsp;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;align=left;verticalAlign=middle;shadow=1;strokeColor=#6c8ebf;gradientColor=#7ea6e0;" vertex="1" parent="1">
